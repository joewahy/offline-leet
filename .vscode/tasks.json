{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Leet: test current file",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m leet test \"${file}\"",
      "group": { "kind": "test", "isDefault": true },
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Leet: list todo",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m leet list --todo",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    },
    {
      "label": "Leet: validate references",
      "type": "shell",
      "command": "${command:python.interpreterPath} -m leet validate",
      "presentation": { "reveal": "always", "panel": "shared", "clear": true },
      "problemMatcher": []
    }
  ]
}
